# Copie para .env.local (ignorado pelo git) e preencha. Nunca commite valores reais.

# Gemini (assistente de planejamento no app) - opcional
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Sincronização bancária (scripts/sync-pluggy.mjs) -------------------------
# Credenciais da aplicação em https://dashboard.pluggy.ai (aba Aplicação)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# IDs dos itens (um por banco conectado via MeuPluggy), separados por vírgula
PLUGGY_ITEM_IDS=

# Conta de serviço do Firebase (Configurações do projeto > Contas de serviço >
# Gerar nova chave privada), colada INTEIRA numa linha só
FIREBASE_SERVICE_ACCOUNT=
# E-mail da conta do Financy que recebe os lançamentos
SYNC_USER_EMAIL=

# (opcional) só importa transações a partir desta data (AAAA-MM-DD); padrão 2026-10-01
# SYNC_FROM=2026-10-01
